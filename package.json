{
  "name": "chengdu-bus",
  "version": "0.1.0",
  "private": true,
  "description": "四川全省公交实时到站语音播报（车来了小程序接口，零依赖）",
  "type": "module",
  "bin": {
    "cd-bus": "./bin/cd-bus.mjs"
  },
  "files": [
    "bin",
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/cd-bus.mjs",
    "near": "node bin/cd-bus.mjs near",
    "cities": "node bin/cd-bus.mjs cities",
    "health": "node bin/cd-bus.mjs health",
    "test": "node test/smoke.mjs && node test/ui-smoke.mjs && node test/dom-smoke.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:ui": "node test/ui-smoke.mjs",
    "test:dom": "node test/dom-smoke.mjs"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.1"
  }
}
