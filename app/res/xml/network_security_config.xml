<?xml version="1.0" encoding="utf-8"?>
<!-- 只允许 HTTPS。App 内所有接口都是 https（车来了 / TTS），
     没有一处明文 http，所以直接禁掉明文能挡住 HTTPS 降级攻击。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
